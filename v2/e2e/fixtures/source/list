#!/usr/bin/env node

import { readFile } from "node:fs/promises";

await readStandardInput();
const tasks = JSON.parse(await readFile(process.env.FIXTURE_TASKS, "utf8"));
process.stdout.write(`${JSON.stringify({ ok: true, data: { tasks } })}\n`);

async function readStandardInput() {
  let input = "";
  for await (const chunk of process.stdin) input += chunk;
  JSON.parse(input);
}

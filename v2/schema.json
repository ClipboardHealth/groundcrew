{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clipboardhealth.com/schemas/groundcrew-v2.schema.json",
  "title": "Groundcrew v2 configuration",
  "type": "object",
  "required": ["workspace", "sources"],
  "properties": {
    "$schema": { "type": "string" },
    "workspace": {
      "type": "object",
      "required": ["baseDirectory"],
      "properties": {
        "baseDirectory": { "type": "string", "minLength": 1 },
        "worktreeDirectory": { "type": "string", "minLength": 1 },
        "prepareWorktree": { "type": "string" },
        "repositories": { "type": "object" }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "agentProfile": { "type": "string", "minLength": 1 },
          "environment": { "type": "object", "additionalProperties": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "agents": { "type": "object" },
    "orchestrator": { "type": "object" },
    "git": { "type": "object" },
    "presenter": { "const": "cmux" },
    "logging": { "type": "object" }
  },
  "additionalProperties": false
}
